# NagoMan API Gateway — Environment Variables
# Copy this file to .env and fill in your values

# Gateway port
GATEWAY_PORT=8080

# JWT Secret — auth-service এর সাথে exact same হতে হবে
# Production-এ strong random secret use করো (min 32 chars)
JWT_SECRET=your_super_secret_key_for_nagoman

# Backend Service URLs
# Local Docker: service name use করো (e.g. http://auth-service:8081)
# Production: actual hostname/IP
AUTH_SERVICE_URL=http://auth-service:8081
SOCIAL_SERVICE_URL=http://social-service:8082
ORG_SERVICE_URL=http://org-service:8083
REPORTS_SERVICE_URL=http://reports-service:8084
ELECTION_SERVICE_URL=http://election-service:8085
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8087
REALTIME_SERVICE_URL=http://realtime-service:8088
